# ---- network (required; services refuse to start if incomplete) ----
STELLAR_NETWORK=testnet                 # testnet | pubnet
STELLAR_NETWORK_PASSPHRASE=
STELLAR_RPC_URL=
USDC_SAC_ID=
PACT_CONTRACT_ID=                       # from pactwright-contracts/deployments/<network>.env
RECEIPT_ANCHOR_ID=

# ---- facilitator ----
FACILITATOR_URL=
FACILITATOR_API_KEY=

# ---- agent ----
AGENT_SECRET_KEY=                       # testnet only; KMS reference in production
SPONSOR_SECRET_KEY=                     # pays reserves for new agent accounts (CAP-33)

# ---- seller ----
SELLER_DELIVERY_KEY=                    # ed25519 secret for X-Pactwright-Delivery
SELLER_SIGNING_KEY_REF=                 # KMS reference for refunds / settle (P7-08)
SELLER_REFUND_VAULT_ID=

# ---- verifier ----
VERIFIER_SECRET_KEY=                    # signs envelopes and attestations
VERIFIER_PROVIDER=                      # LLM provider for the model adapter (V-03)
VERIFIER_MODEL=                         # pinned model ID; recorded in every envelope
VERIFIER_EFFORT=                        # explicit reasoning effort, where the provider supports it
VERIFIER_LLM_API_KEY=                   # required: the verifier refuses to start without it
LLM_BASE_URL=                           # OpenAI-compatible provider base URL (optional)
EVIDENCE_BUCKET_URL=                    # https prefix the verifier fetches evidence from
VERIFIER_PORT=                          # defaults to the host's PORT, then 8787
