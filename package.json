{
  "name": "pactwright-kit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm --filter @witness/core run typecheck && pnpm --filter @witness/core run build && pnpm --filter @accensa/sdk run typecheck && pnpm --filter @accensa/sdk run build && pnpm --filter @pactwright/contracts-client run build && tsc -p tsconfig.json",
    "test": "vitest run",
    "eval": "pnpm build && node services/verifier/eval/run.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "e2e:testnet": "vitest run --config e2e/testnet/vitest.config.ts",
    "e2e:kms": "E2E_FILE=e2e/testnet/kms.e2e.ts vitest run --config e2e/testnet/vitest.config.ts",
    "e2e:hosted-verifier": "E2E_FILE=e2e/testnet/hosted-verifier.e2e.ts vitest run --config e2e/testnet/vitest.config.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.46.0"
  }
}
